Module {
	name: 'm2ng'
	description: 'M2NG is an ambitious initiative aimed at reviving and modernizing Modula-2 codebases while providing the flexibility to transpile them into various contemporary languages, as well as to compile it to portable architectures such as the JVM, WebAssembly, and platform specific architectures such as the x86 and x86-64.'
	version: '0.0.1'
	license: 'MIT'
	dependencies: []
}
